{
  "manifest_version": 3,
  "name": "PWA link organizer",
  "version": "1.2.1",
  "description": "Öffnet Links aus der Outlook-App in Microsoft Edge statt in einem Chrome-Tab (lokal über einen Native-Messaging-Host).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://outlook.cloud.microsoft/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "PWA link organizer: Edge-Profil wählen",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
