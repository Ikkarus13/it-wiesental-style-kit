{
  "manifest_version": 3,
  "name": "PWA-Tray: Teams-Status",
  "version": "1.0.2",
  "description": "Meldet Teams-Status und ungelesene Nachrichten an das PWA-Tray-Symbol (lokal, nichts geht ins Internet).",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.cloud.microsoft/*",
        "https://teams.microsoft.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://teams.cloud.microsoft/*",
    "https://teams.microsoft.com/*"
  ]
}
